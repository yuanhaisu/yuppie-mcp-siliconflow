# 硅基流动 API Key（必填）
# 国际站控制台：https://cloud.siliconflow.com/account/ak
SILICONFLOW_API_KEY=sk-你的APIKey

# 可选：API Base URL
#   国际站（默认）：https://api.siliconflow.com
#   国内站：        https://api.siliconflow.cn
SILICONFLOW_BASE_URL=https://api.siliconflow.com

# 可选：默认文生图模型
#   默认 Tongyi-MAI/Z-Image-Turbo —— 规避 FLUX.1-schnell / FLUX.1-dev
#   返回的 S3 预签名 URL 签名无效（403 SignatureDoesNotMatch）的坑。
SILICONFLOW_MODEL=Tongyi-MAI/Z-Image-Turbo

# 可选：生成结果保存目录。
#   图片字节无论是否配置本项都会下载（用于内联成原生图片块）；
#   不设则只内联、不落盘。
SILICONFLOW_IMAGE_DIR=
